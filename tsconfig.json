{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src"],
  // styles.test.ts だけ node:fs で CSS を読む。@types/node を増やさないため対象外にする
  "exclude": ["src/styles.test.ts"]
}
