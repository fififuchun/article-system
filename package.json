{
  "name": "@fififuchun/article-system",
  "version": "0.5.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest"
  },
  "browserslist": [
    "chrome >= 108",
    "edge >= 108",
    "safari >= 15.4",
    "firefox >= 101"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "react-markdown": "^9.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.11"
  }
}
